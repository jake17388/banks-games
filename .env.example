# Server port (backend)
PORT=3001

# Comma-separated list of allowed CORS origins for the Socket.IO server
# Add your deployed frontend URL here alongside localhost for dev
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://property-deal-chi.vercel.app,https://jake17388.github.io

# URL of the Socket.IO backend server (used by the React frontend at build time)
# For local dev this defaults to http://localhost:3001 — only set this for production builds
# VITE_SERVER_URL=https://your-backend.onrender.com
